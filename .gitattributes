# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf
# Hand-authored resources too: JSON must stay LF regardless of the
# checkout platform, otherwise CRLF editors produce noisy diffs.
src/main/resources/**/*.json text eol=lf
# Minecraft resource formats: keep LF regardless of checkout platform
pack.mcmeta text eol=lf
*.snbt text eol=lf
neoforge.mods.toml text eol=lf
